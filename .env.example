# LLM provider configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11500/v1
OLLAMA_API_KEY=ollama
LLM_MAX_TURNS=3
LLM_TRACING_DISABLED=true

# Optional runtime instantiation contract
# RUN_REPOSITORY=https://github.com/jkoppel/QuixBugs.git
# RUN_BRANCH=master
# RUN_ARCHITECTURE=mono-agent
# RUN_AGENT_MODELS={"main":"llama3.1:8b"}
# RUN_BOOTSTRAP_PROMPT=Fix failing tests with minimal changes.
# RUN_TEST_COMMAND=uv run --with pytest pytest python_testcases/test_gcd.py

# QuixBugs minimal real run
RUN_REPOSITORY=https://github.com/jkoppel/QuixBugs.git
RUN_BRANCH=master
RUN_ARCHITECTURE=mono-agent
RUN_AGENT_MODELS={"main":"qwen2.5-coder:14b"}
RUN_BOOTSTRAP_PROMPT=Fix the failing QuixBugs Python gcd implementation with the smallest correct change. Inspect the target function and related test, reproduce the failure, patch only the buggy implementation, rerun the focused test, and inspect the final diff before reporting done.
RUN_TEST_COMMAND=uv run --with pytest pytest python_testcases/test_gcd.py
AUTOFIX_RESULTS_DIR=/results
AUTOFIX_OBSERVABILITY_DB=/results/observability.db
AUTOFIX_INTERACTIVE=false

# Optional observability config
# AUTOFIX_OBSERVABILITY_ENABLED=true
# AUTOFIX_RESULTS_DIR=results
# AUTOFIX_OBSERVABILITY_DB=results/observability.db
# AUTOFIX_LIVE_LOG=true
