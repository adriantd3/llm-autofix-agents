# .env — ONLY secrets and host-local debug settings.
# Batch execution configuration lives in the batch YAML files.
# The runner propagates API keys automatically; everything else comes from batch config.

# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# OPENCODE_GO_API_KEY=sk-...

# Optional host-local debug (does NOT propagate to containers)
# AUTOFIX_LOG_LEVEL=INFO
